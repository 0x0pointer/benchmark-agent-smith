                             \n                \n                               
                             <li class=\"nav-item\">\n                          
                             <a class=\"nav-link\"                              
                             href=\"/add_prescription\">Add                     
                             Prescription</a>\n                                 
                             </li>\n                <li                         
                             class=\"nav-item\">\n                              
                             <a class=\"nav-link\"                              
                             href=\"/view_prescriptions\">View                  
