                             http://172.17.0.1:48805/password/test              
                             > /tmp/pw_page.html\ncat                           
                             /tmp/pw_page.html | grep -i                        
                             'user_id\\|username\\|hidden\\|value='             
                             \n\n# Step 3: Submit password                      
