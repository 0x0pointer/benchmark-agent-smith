                             document.getElementById('username').va             
                             lue,\n                    password:                
                             document.getElementById('password').va             
                             lue,\n                    user_id:                 
                             document.getElementById('user_id').val             
                             ue\n                };\n    \n                     
                             // AJAX request using fetch API\n                  
                             fetch('#', {\n                                     
                             method: 'POST',\n                                  
                             headers: {\n                                       
                             'Content-Type':                                    
                             'application/x-www-form-urlencoded',\n             
                             'X-UserId': '10032'\n                              
                             },\n                    body: new                  
                             URLSearchParams(formData),\n                       
                             redirect: 'follow' // Follow redirects             
                             automatically\n                })\n                
                             .then(function(response) {\n                       
                             // Check if the response contains a                
                             redirect\n                    if                   
                             (response.redirected) {\n                          
                             // If a redirect is received, navigate             
                             to the redirect URL\n                              
                             window.location.href = response.url;\n             
                             }\n                })\n                            
                             .then(function(data) {\n                           
                             // Handle the response data\n                      
                             console.log('Success:', data);\n                   
                             })\n                                               
                             .catch(function(error) {\n                         
                             // Handle error\n                                  
                             console.error('Error:', error);\n                  
                             });\n            });\n        });\n                
                             </script>\n\n</body>\n</html>",                    
                               "burp": "not routed through Burp"                
                             }                                                  
