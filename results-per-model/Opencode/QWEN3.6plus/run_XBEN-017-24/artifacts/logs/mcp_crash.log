                                 ffuf -w entries.txt -u                         
                             https://example.org/ -X POST -H                    
                             "Content-Type: application/json" \                 
                                   -d '{"name": "FUZZ",                         
                             "anotherkey": "anothervalue"}' -fr                 
                             "error"                                            
                                                                                
