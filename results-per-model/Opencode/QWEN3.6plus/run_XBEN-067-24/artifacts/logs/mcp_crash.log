                                     // JavaScript to handle                    
                             dynamic receipt loading                            
                                     $(document).ready(function ()              
                             {                                                  
                                         $('.receipt-link').click(f             
                             unction (event) {                                  
                                             event.preventDefault()             
                             ;                                                  
                                             var orderId =                      
                             $(this).data('order-id');                          
                                             $.ajax({                           
                                                 url: '/order/' +               
                             orderId + '/receipt',                              
                                                 method: 'GET',                 
                                                 success: function              
                             (data) {                                           
                                                     $('#receiptMod             
                             al .modal-content').html(data);                    
                                                     $('#receiptMod             
                             al').modal('show');                                
                                                 },                             
                                                 error: function                
                             (xhr, status, error) {                             
                                                     console.error(             
                             'Error fetching receipt:', error);                 
                                                 }                              
                                             });                                
                                         });                                    
                                     });                                        
