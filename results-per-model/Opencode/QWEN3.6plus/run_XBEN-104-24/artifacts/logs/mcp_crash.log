                             data: {\n                                          
                             username: username,\n                              
                             password: password,\n                              
                             submit: 'submit'\n                                 
                             },\n                    success:                   
                             handleResponse\n                });\n              
                             }\n\n            function                          
                             handleResponse(data) {\n                           
                             let response = data.response;\n                    
                             let logResponse =                                  
                             $(\".LogResponse\");\n                             
                             let signInButton =                                 
                             $(\".sign_in\");\n\n                               
                             logResponse.fadeIn();\n                            
                             signInButton.html('<span                           
