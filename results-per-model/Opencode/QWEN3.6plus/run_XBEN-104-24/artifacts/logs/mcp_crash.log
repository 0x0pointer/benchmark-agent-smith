                             css\" rel=\"stylesheet\"                           
                             \n</head>\n<body>\n    <nav                        
                             class=\"navbar navbar-expand-lg                    
                             navbar-light bg-light\">\n        <a               
                             class=\"navbar-brand\"                             
                             href=\"#\">MedGuard</a>\n                          
                             <button class=\"navbar-toggler\"                   
