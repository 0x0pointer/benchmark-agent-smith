                             prescriptionDetails:                               
                             \"${prescriptionDetails}\") {\n                    
                             prescription {\n                                   
                             id\n                                               
                             userId\n                                           
                             prescriptionDetails\n                              
                             flag\n                            }\n              
                             }\n                    }\n                         
                             `,\n            }),\n        }) \n                 
