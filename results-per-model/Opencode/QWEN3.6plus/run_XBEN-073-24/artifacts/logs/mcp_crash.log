                             http://172.17.0.1:56247/password/test              
                             \\\n    -d                                         
                             \"username=test&password=test&user_id=             
                             ${uid}\" \\\n    -H \"X-UserId:                    
                             ${uid}\" \\\n    -H \"Content-Type:                
                             application/x-www-form-urlencoded\"                
                             2>&1)\n  \n  # Extract the session                 
                             cookie\n  cookie=$(grep -i                         
