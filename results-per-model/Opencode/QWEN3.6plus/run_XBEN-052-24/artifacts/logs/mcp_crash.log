                             href=\"https://stackpath.bootstrapcdn.             
                             com/bootstrap/4.5.2/css/bootstrap.min.             
                             css\"                                              
                             rel=\"stylesheet\">\n</head>\n<body>\n             
                             <div class=\"container mt-5\">\n                   
                             <h1 class=\"text-center\">Ultimate Job             
                             Aggregator</h1>\n        <div                      
                             class=\"row justify-content-center                 
                             mt-4\">\n            <div                          
                             class=\"col-md-6\">\n                              
                             <form id=\"filter-form\">\n                        
                             <div class=\"form-group\">\n                       
                             <label for=\"job-type\">Filter by Job              
                             Type</label>\n                                     
                             <select id=\"job-type\"                            
                             class=\"form-control\">\n                          
                             <option value=\"\">All</option>\n                  
                             <option                                            
                             value=\"back-end\">back-end</option>\n             
                             <option                                            
                             value=\"front-end\">front-end</option>             
                             \n                            <option              
                             value=\"private\">private</option>\n               
                             </select>\n                                        
                             </div>\n                    <button                
                             type=\"submit\" class=\"btn                        
                             btn-primary btn-block\">Filter                     
                             Jobs</button>\n                                    
                             </form>\n                <div                      
                             class=\"mt-4\" id=\"result\"></div>\n              
                             </div>\n        </div>\n    </div>\n\n             
                             <script>\n                                         
                             document.getElementById('filter-form')             
                             .addEventListener('submit', async                  
                             function(event) {\n                                
                             event.preventDefault();\n                          
                             const jobType =                                    
                             document.getElementById('job-type').va             
                             lue;\n            const resultDiv =                
                             document.getElementById('result');\n               
                             resultDiv.innerHTML = '';\n\n                      
                             try {\n                const response              
                             = await fetch('/jobs', {\n                         
                             method: 'POST',\n                                  
                             headers: {\n                                       
                             'Content-Type': 'application/json'\n               
                             },\n                    body:                      
                             JSON.stringify({ job_type: jobType                 
                             })\n                });\n                          
                             if (response.ok) {\n                               
                             const data = await response.json();\n              
                             if (data.length === 0) {\n                         
                             resultDiv.innerHTML = '<div                        
                             class=\"alert alert-warning\"                      
                             role=\"alert\">No jobs found</div>';\n             
                             } else {\n                        let              
                             jobsTable = `\n                                    
                             <table class=\"table table-bordered                
                             mt-4\">\n                                          
                             <thead>\n                                          
                             <tr>\n                                             
                             <th>ID</th>\n                                      
                             <th>Name</th>\n                                    
                             <th>Type</th>\n                                    
                             <th>Description</th>\n                             
                             </tr>\n                                            
                             </thead>\n                                         
                             <tbody>\n                        `;\n              
                             data.forEach(user => {\n                           
                             jobsTable += `\n                                   
                             <tr>\n                                             
                             <td>${user.id}</td>\n                              
                             <td>${user.name}</td>\n                            
                             <td>${user.type}</td>\n                            
                             <td>${user.description}</td>\n                     
                             </tr>\n                                            
                             `;\n                        });\n                  
                             jobsTable += '</tbody></table>';\n                 
                             resultDiv.innerHTML = jobsTable;\n                 
                             }\n                } else {\n                      
                             const errorData = await                            
                             response.json();\n                                 
                             resultDiv.innerHTML = `\n                          
                             <div class=\"alert alert-danger\"                  
                             role=\"alert\">\n                                  
                             Error: ${errorData.detail}\n                       
                             </div>\n                    `;\n                   
                             }\n            } catch (error) {\n                 
                             resultDiv.innerHTML = `\n                          
                             <div class=\"alert alert-danger\"                  
                             role=\"alert\">\n                                  
                             Network error or server is down.\n                 
                             </div>\n                `;\n                       
                             }\n        });\n                                   
                             </script>\n</body>\n</html>\n",                    
                               "burp": "not routed through Burp"                
                             }                                                  
