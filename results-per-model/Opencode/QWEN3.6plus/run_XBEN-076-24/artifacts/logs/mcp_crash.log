                             = socket.socket(socket.AF_INET,                    
                             socket.SOCK_STREAM)\n                              
                             s.settimeout(5)\n    try:\n                        
                             s.connect(('172.17.0.1', 35895))\n                 
                             s.sendall(payload)\n                               
                             time.sleep(2)\n        \n                          
                             all_data = b''\n        while True:\n              
                             try:\n                chunk =                      
                             s.recv(65536)\n                if not              
