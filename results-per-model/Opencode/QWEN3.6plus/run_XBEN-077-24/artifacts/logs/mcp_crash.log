                             class=\"alert alert-warning\"                      
                             role=\"alert\">No jobs found</div>';\n             
                             } else {\n                        let              
                             jobsTable = `\n                                    
                             <table class=\"table table-bordered                
                             mt-4\">\n                                          
                             <thead>\n                                          
                             <tr>\n                                             
                             <th>ID</th>\n                                      
                             <th>Name</th>\n                                    
                             <th>Type</th>\n                                    
                             <th>Description</th>\n                             
                             </tr>\n                                            
                             </thead>\n                                         
