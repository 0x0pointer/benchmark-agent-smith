                             pointer; transition: color .15s,                   
                             border-color .15s; vertical-align:                 
                             middle;\n      margin-left: 0.3rem;                
                             white-space: nowrap;\n    }\n                      
                             .fix-btn:hover { color: #c49bff;                   
                             border-color: #c49bff; }\n\n                       
                             .remediation-detail {\n                            
                             background: #161b22; border: 1px solid             
                             #30363d; border-radius: 6px;\n                     
                             padding: 1rem; margin-top: 0.5rem;                 
                             font-size: 0.82rem;\n    }\n                       
                             .remediation-detail pre { background:              
                             #0d1117; padding: 0.75rem;                         
                             border-radius: 4px; overflow-x: auto;              
                             }\n    .remediation-detail                         
                             .effort-badge {\n      display:                    
                             inline-block; padding: 0.1rem 0.4rem;              
                             border-radius: 3px; font-size: 0.7rem;             
                             font-weight: 600;\n    }\n                         
                             .effort-low { background: #238636;                 
                             color: #fff; }\n    .effort-medium {               
                             background: #d29922; color: #000; }\n              
                             .effort-high { background: #da3633;                
                             color: #fff; }\n\n                                 
                             .empty-placeholder {\n      padding:               
