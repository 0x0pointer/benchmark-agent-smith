                             max-height: 260px; overflow-y: auto;\n             
                             }\n\n    .copy-gh-btn {\n                          
                             display: inline-flex; align-items:                 
                             center; gap: 0.3rem;\n                             
                             background: none; border: 1px solid                
                             #30363d; border-radius: 4px;\n                     
                             color: #6e7681; padding: 0.15rem                   
                             0.45rem; font-size: 0.72rem;\n                     
                             cursor: pointer; transition: color                 
                             .15s, border-color .15s;                           
                             vertical-align: middle;\n                          
                             margin-left: 0.5rem; white-space:                  
                             nowrap;\n    }\n    .copy-gh-btn:hover             
                             { color: #58a6ff; border-color:                    
                             #58a6ff; }\n    .copy-gh-btn.copied {              
                             color: #3fb950; border-color: #3fb950;             
                             }\n\n    .replay-btn {\n      display:             
                             inline-flex; align-items: center; gap:             
                             0.3rem;\n      background: none;                   
                             border: 1px solid #30363d;                         
                             border-radius: 4px;\n      color:                  
                             #d29922; padding: 0.15rem 0.45rem;                 
                             font-size: 0.72rem;\n      cursor:                 
                             pointer; transition: color .15s,                   
                             border-color .15s; vertical-align:                 
                             middle;\n      margin-left: 0.3rem;                
                             white-space: nowrap;\n    }\n                      
                             .replay-btn:hover { color: #e3b341;                
                             border-color: #e3b341; }\n                         
                             .replay-btn.copied { color: #3fb950;               
                             border-color: #3fb950; }\n\n                       
                             .fix-btn {\n      display:                         
                             inline-flex; align-items: center; gap:             
                             0.3rem;\n      background: none;                   
                             border: 1px solid #30363d;                         
                             border-radius: 4px;\n      color:                  
