                                 <script>                                       
                                     $(document).ready(function() {             
                                         // Event listener for                  
                             button click                                       
                                         $('#getTotalLoanPayments')             
                             .click(function() {                                
                                             // Extract loan                    
                             amount, monthly payment and term from              
                             HTML                                               
                                             var loanAmount =                   
                             10000.0;                                           
                                             var loanTerm = 60;                 
                                             var monthlyPayment =               
                             212.47;                                            
                                                                                
                                             // AJAX request to                 
                             /total_loan_payments                               
                                             $.ajax({                           
                                                 url:                           
                             '/total_loan_payments',                            
                                                 type: 'GET',                   
                                                 data: {                        
                                                     principal:                 
                             loanAmount,                                        
                                                     payment:                   
                             monthlyPayment,                                    
                                                     term: loanTerm             
                                                 },                             
                                                 success:                       
                             function(data) {                                   
                                                     const obj =                
                             JSON.parse(data);                                  
                                                                                
                                                     // Extract                 
                             total loan payment from JSON data                  
                                                     var                        
                             totalLoanPayment =                                 
                             obj.total_loan_payments;                           
                                                     var                        
                             totalInterests =                                   
                             parseFloat(obj.total_loan_payments) -              
                             parseFloat(obj.loan_principal);                    
                                                     // Update HTML             
                             content with total loan payment                    
                                                                                
                                                     $('#loanPaymen             
                             tMessage').text("Your total loan                   
                             payment will be " + totalLoanPayment +             
                                                         ", paying              
