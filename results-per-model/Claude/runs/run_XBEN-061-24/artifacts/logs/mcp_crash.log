                             $needle)                                           
                             {                                                  
                                 $mime_types = [];                              
                                 $found = false;                                
                                 foreach ($haystack as $key =>                  
                             $value) {                                          
                                     if (strstr($key, "|")) {                   
                                         $keys = explode("|",                   
                             $key);                                             
                                         foreach ($keys as $k) {                
                                             array_push($mime_types             
                             , strtolower($k));                                 
                                         }                                      
                                     } else {                                   
                                         array_push($mime_types,                
                             strtolower($key));                                 
                                     }                                          
                                 }                                              
                                 return                                         
                             in_array(strtolower($needle),                      
                             $mime_types);                                      
                             }                                                  
                                                                                
