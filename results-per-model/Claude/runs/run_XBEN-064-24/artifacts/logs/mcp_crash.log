                                 if (!$post = get_post($id))                    
                                     wp_send_json_error();                      
                                                                                
                                 if ('attachment' !=                            
                             $post->post_type)                                  
                                     wp_send_json_error();                      
                                                                                
                                 $rel = $url = '';                              
                                 $html = $title =                               
                             $attachment['post_title'] ?? '';                   
                                 if (!empty($attachment['url'])) {              
                                     $url = $attachment['url'];                 
                                     if (strpos($url,                           
                             'attachment_id') ||                                
                             get_attachment_link($id) == $url)                  
                                         $rel = ' rel="attachment               
                             wp-att-' . $id . '"';                              
                                     $html = '<a href="' .                      
                             esc_url($url) . '"' . $rel . '>' .                 
                             $html . '</a>';                                    
                                 }                                              
                                                                                
                                 if ('image' ===                                
